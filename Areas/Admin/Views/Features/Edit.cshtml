@model Truck_company.ViewModels.FeatureInputViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add Feature" : "Edit Feature"; }
<div class="admin-panel">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <form asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>
        <input asp-for="Id" type="hidden" />
        <div class="form-grid">
            <div class="field full-span"><label asp-for="Title"></label><input asp-for="Title" /></div>
            <div class="field full-span"><label asp-for="Description"></label><textarea asp-for="Description"></textarea></div>
            <div class="field"><label asp-for="Icon"></label><select asp-for="Icon"><option value="shield">Shield</option><option value="users">Team</option><option value="check">Checklist</option><option value="dollar">Rates</option><option value="location">Location</option></select></div>
            <div class="field"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" /></div>
            <div class="field"><label asp-for="IsActive"></label><select asp-for="IsActive"><option value="true">Active</option><option value="false">Inactive</option></select></div>
        </div>
        <div class="actions"><button class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
    </form>
</div>
