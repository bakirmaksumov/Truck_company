@model List<Truck_company.Models.Feature>
@{ ViewData["Title"] = "Why Choose Us"; }
<div class="admin-panel">
    <div class="panel-heading">
        <h1 class="page-title">Why Choose Us</h1>
        <a asp-action="Create" class="btn btn-primary">Add feature</a>
    </div>
    <div class="responsive-table">
        <table class="table">
            <thead>
                <tr><th>Title</th><th>Order</th><th>Active</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong><small>@item.Description</small></td>
                        <td>@item.DisplayOrder</td>
                        <td>@(item.IsActive ? "Yes" : "No")</td>
                        <td class="row-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Edit</a>
                            <form asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-danger" onclick="return confirm('Delete this feature?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
