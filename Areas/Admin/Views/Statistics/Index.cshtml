@model List<Truck_company.Models.Statistic>
@{ ViewData["Title"] = "Statistics"; }
<div class="admin-panel">
    <div class="panel-heading">
        <h1 class="page-title">About Statistics</h1>
        <a asp-action="Create" class="btn btn-primary">Add statistic</a>
    </div>
    <div class="responsive-table">
        <table class="table">
            <thead>
                <tr><th>Value</th><th>Label</th><th>Order</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Value</strong></td>
                    <td>@item.Label</td>
                    <td>@item.DisplayOrder</td>
                    <td class="row-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Edit</a>
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-danger" onclick="return confirm('Delete this statistic?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
