@model List<Truck_company.Models.QuoteRequest>
@{
    ViewData["Title"] = "Quote Requests";
    var selectedStatus = ViewBag.SelectedStatus ?? "All";
}

<div class="admin-panel">
    <h1 class="page-title">Quote Requests</h1>

    <form method="get" class="admin-search" style="margin-bottom: 18px;">
        <input name="search" value="@(Context.Request.Query["search"])" placeholder="Name, email, phone or company" />
        <select name="status" class="form-control" onchange="this.form.submit()" style="width:100%; min-height:43px; border-radius:10px; border:1px solid #ddd; padding:10px 12px;">
            <option value="">All</option>
            @foreach (var status in Enum.GetNames(typeof(Truck_company.Models.QuoteStatus)))
            {
                <option value="@status" selected="@(selectedStatus == status ? true : null)">@status</option>
            }
        </select>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Route</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.PickupLocation → @item.DeliveryLocation</td>
                        <td>@item.Phone</td>
                        <td>
                            <form asp-action="UpdateStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <select name="status" onchange="this.form.submit()" style="min-width: 130px; border-radius: 8px; border: 1px solid #ddd; padding: 8px 10px;">
                                    @foreach (var status in Enum.GetNames(typeof(Truck_company.Models.QuoteStatus)))
                                    {
                                        <option value="@status" selected="@(item.Status.ToString() == status ? true : null)">@status</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">View</a>
                            <form asp-action="Delete" method="post" style="display:inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-danger" onclick="return confirm('Delete this request?');">Delete</button></form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">No quote requests found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
