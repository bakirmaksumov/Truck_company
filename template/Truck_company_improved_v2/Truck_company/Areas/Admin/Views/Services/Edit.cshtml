@model Truck_company.Models.Service
@{
    ViewData["Title"] = "Edit Service";
}

<div class="admin-panel">
    <h1 class="page-title">Edit Service</h1>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="form-grid">
            <div class="field full-span">
                <label asp-for="Title"></label>
                <input asp-for="Title" />
                <span asp-validation-for="Title"></span>
            </div>
            <div class="field full-span">
                <label asp-for="ShortDescription"></label>
                <textarea asp-for="ShortDescription"></textarea>
                <span asp-validation-for="ShortDescription"></span>
            </div>
            <div class="field full-span">
                <label asp-for="FullDescription"></label>
                <textarea asp-for="FullDescription"></textarea>
            </div>
            <div class="field">
                <label asp-for="Icon"></label>
                <input asp-for="Icon" />
            </div>
            <div class="field">
                <label asp-for="ImageUrl"></label>
                <input asp-for="ImageUrl" />
            </div>
            <div class="field"><label>Replace image</label><input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp" /></div>
            <div class="field">
                <label asp-for="DisplayOrder"></label>
                <input asp-for="DisplayOrder" type="number" />
            </div>
            <div class="field">
                <label asp-for="IsActive"></label>
                <select asp-for="IsActive">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
