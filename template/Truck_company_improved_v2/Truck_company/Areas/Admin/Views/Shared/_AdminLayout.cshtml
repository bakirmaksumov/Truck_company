<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; font-family: 'Montserrat', sans-serif; background: #efefef; color: #101010; }
        a { text-decoration: none; }
        body.admin-page { background: #f5f5f3; }
        .admin-header { background: #0b0d10; color: white; padding: 18px 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #f3c534; }
        .admin-brand { display: flex; align-items: center; gap: 12px; font-weight: 900; font-size: 1.8rem; letter-spacing: -.05em; text-transform: uppercase; }
        .admin-brand .brand-mark { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; background: #f3c534; color: #0b0d10; border-radius: 10px; }
        .admin-brand small { color: #f3c534; font-size: 0.62rem; letter-spacing: .2em; display: block; }
        .admin-body { display: grid; grid-template-columns: 220px 1fr; min-height: calc(100vh - 80px); }
        .admin-sidebar { background: #101315; padding: 28px 16px; }
        .admin-sidebar a { display: flex; align-items:center; gap:10px; color: #f8f8f8; padding: 12px 14px; border-radius: 10px; margin-bottom: 8px; font-weight: 600; }
        .admin-sidebar a.active, .admin-sidebar a:hover { background: rgba(243,197,52,0.15); color: #f3c534; }
        .admin-content { padding: 28px; }
        .admin-panel { background: white; border-radius: 18px; box-shadow: 0 12px 32px rgba(12,12,12,0.08); padding: 24px; }
        .page-title { font-size: 2.1rem; font-weight: 900; letter-spacing: -.05em; margin: 0 0 20px; }
        .dashboard-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 18px; margin-bottom: 24px; }
        .metric-card { background: linear-gradient(180deg, #111315, #1a1d20); color: white; border-radius: 18px; padding: 28px 20px; border: 1px solid rgba(243,197,52,0.4); }
        .metric-card .label { color: rgba(255,255,255,0.74); display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: .08em; }
        .metric-card strong { font-size: 2rem; display: block; margin-top: 12px; }
        .table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .table th, .table td { padding: 12px 10px; border-bottom: 1px solid #e7e7e7; text-align: left; }
        .table th { background: #f8f8f8; font-size: 0.8rem; text-transform: uppercase; letter-spacing: .06em; }
        .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; border-radius: 10px; padding: 0 16px; border: 0; cursor: pointer; font-weight: 700; }
        .btn-primary { background: #f3c534; color: #090909; }
        .btn-secondary { background: #101315; color: white; }
        .btn-danger { background: #d64545; color: white; }
        .status-badge { display: inline-block; padding: 6px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
        .status-new { background: #fff3c6; color: #8a6200; }
        .status-inprogress { background: #d9ebff; color: #124c93; }
        .status-contacted { background: #dff9e8; color: #0f6d40; }
        .status-completed { background: #d9f9e4; color: #0d6b43; }
        .status-archived { background: #f1f1f1; color: #4a4a4a; }
        .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
        .field { display: flex; flex-direction: column; gap: 8px; }
        .field input, .field textarea, .field select { width: 100%; min-height: 46px; border-radius: 10px; border: 1px solid #ddd; padding: 10px 12px; }
        .field textarea { min-height: 110px; resize: vertical; }
        .full-span { grid-column: 1 / -1; }
        .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
        .panel-heading,.row-actions { display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .row-actions { justify-content:flex-start; }
        .row-actions form { margin:0; }
        .table td small { display:block; color:#777; margin-top:5px; max-width:520px; }
        .responsive-table { overflow-x:auto; }
        .admin-search { display:flex; gap:8px; }
        .admin-search input { min-height:40px; border:1px solid #ddd; border-radius:10px; padding:8px 12px; }
        .validation-summary-errors { background:#fff1f1;color:#9d2020;padding:12px 16px;border-radius:10px;margin-bottom:16px; }
        .admin-success { background: #eafaf1; color: #0b6f3a; border-left: 4px solid #0b6f3a; padding: 12px 14px; margin-bottom: 16px; border-radius: 10px; }
        @@media(max-width:820px){.admin-body{grid-template-columns:1fr}.admin-sidebar{display:flex;overflow-x:auto;padding:12px}.admin-sidebar a{white-space:nowrap;margin:0}.admin-content{padding:14px}.form-grid{grid-template-columns:1fr}.full-span{grid-column:auto}.admin-header{padding:14px}.admin-brand{font-size:1.2rem}}
    </style>
</head>
<body class="admin-page">
    <header class="admin-header">
        <div class="admin-brand">
            <span class="brand-mark"><i class="fa-solid fa-truck-fast"></i></span>
            <span>
                Express
                <small>Admin</small>
            </span>
        </div>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">View Site</a>
    </header>

    <div class="admin-body">
        <aside class="admin-sidebar">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
            <a asp-area="Admin" asp-controller="Services" asp-action="Index"><i class="fa-solid fa-truck"></i> Services</a>
            <a asp-area="Admin" asp-controller="Features" asp-action="Index"><i class="fa-solid fa-shield"></i> Features</a>
            <a asp-area="Admin" asp-controller="Statistics" asp-action="Index"><i class="fa-solid fa-arrow-trend-up"></i> Statistics</a>
            <a asp-area="Admin" asp-controller="QuoteRequests" asp-action="Index"><i class="fa-solid fa-file-invoice"></i> Quotes</a>
            <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index"><i class="fa-solid fa-envelope"></i> Messages</a>
            <a asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="fa-solid fa-gear"></i> Settings</a>
            <a asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="btn btn-secondary" style="margin-top: 12px; width: 100%;">Logout</button>
            </form>
        </aside>
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>
</body>
</html>
