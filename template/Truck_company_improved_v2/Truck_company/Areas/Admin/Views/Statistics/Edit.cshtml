@model Truck_company.Models.Statistic
@{ ViewData["Title"] = Model.Id == 0 ? "Add Statistic" : "Edit Statistic"; }
<div class="admin-panel"><h1 class="page-title">@ViewData["Title"]</h1><form asp-action="Save" method="post"><div asp-validation-summary="ModelOnly"></div><input asp-for="Id" type="hidden"/><div class="form-grid"><div class="field"><label asp-for="Value"></label><input asp-for="Value"/></div><div class="field"><label asp-for="Label"></label><input asp-for="Label"/></div><div class="field"><label asp-for="Icon"></label><input asp-for="Icon"/></div><div class="field"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number"/></div><div class="field"><label asp-for="IsActive"></label><select asp-for="IsActive"><option value="true">Active</option><option value="false">Inactive</option></select></div></div><div class="actions"><button class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form></div>
